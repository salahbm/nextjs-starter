{
  "name": "nextjs-starter",
  "version": "0.3.1",
  "private": true,
  "author": {
    "name": "Mukhammad",
    "email": "salahbm.001@gmail.com"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "next experimental-analyze --output",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ui": "ladle serve",
    "ui:build": "ladle build",
    "lhci": "lhci autorun",
    "type-check": "tsc --noEmit",
    "commit": "bun exec git-cz",
    "release": "bun exec standard-version",
    "release:minor": "bun exec standard-version --release-as minor",
    "release:major": "bun exec standard-version --release-as major",
    "release:patch": "bun exec standard-version --release-as patch"
  },
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@sentry/nextjs": "10.56.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "js-cookie": "3.0.8",
    "libphonenumber-js": "1.13.5",
    "lodash": "4.18.1",
    "lucide-react": "1.17.0",
    "next": "16.2.7",
    "next-intl": "4.13.0",
    "next-themes": "0.4.6",
    "nuqs": "2.8.9",
    "radix-ui": "1.4.3",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "7.77.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/js": "10.0.1",
    "@ladle/react": "5.1.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@tanstack/eslint-plugin-query": "5.101.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "4.17.24",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.4.1",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.7",
    "playwright": "1.60.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "standard-version": "9.5.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "bun@1.3.14"
}
