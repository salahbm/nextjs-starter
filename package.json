{
  "name": "nextjs-starter",
  "version": "0.3.3",
  "private": true,
  "author": {
    "name": "Mukhammad",
    "email": "salahbm.001@gmail.com"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "next experimental-analyze --output",
    "start": "next start",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ui": "ladle serve",
    "ui:build": "ladle build",
    "lhci": "lhci autorun",
    "type-check": "tsc --noEmit",
    "commit": "bun exec git-cz",
    "release": "bun exec standard-version",
    "release:minor": "bun exec standard-version --release-as minor",
    "release:major": "bun exec standard-version --release-as major",
    "release:patch": "bun exec standard-version --release-as patch"
  },
  "engines": {
